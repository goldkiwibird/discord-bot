    "check-in": {
      "description": "Check in once a day to earn points.",
      "name_localizations": {
        "ko": "출석",
        "zh-TW": "簽到"
      },
      "description_localizations": {
        "ko": "하루 한 번 출석하고 포인트를 받습니다.",
        "zh-TW": "每天簽到一次即可獲得點數。"
      }
    },
    "points": {
      "description": "Check your current point balance.",
      "name_localizations": {
        "ko": "포인트",
        "zh-TW": "點數"
      },
      "description_localizations": {
        "ko": "현재 보유 포인트를 확인합니다.",
        "zh-TW": "查詢目前持有的點數。"
      }
    },
    "summon": {
      "description": "Spend points to summon one hero card.",
      "name_localizations": {
        "ko": "소환",
        "zh-TW": "召喚"
      },
      "description_localizations": {
        "ko": "포인트를 소모해 영웅 카드를 1회 소환합니다.",
        "zh-TW": "消耗點數召喚一張英雄卡。"
      }
    },
    "summon-10": {
      "description": "Spend points to summon ten hero cards at once.",
      "name_localizations": {
        "ko": "10소환",
        "zh-TW": "十連召喚"
      },
      "description_localizations": {
        "ko": "포인트를 소모해 영웅 카드를 10회 소환합니다.",
        "zh-TW": "消耗點數一次召喚十張英雄卡。"
      }
    },
    "deck": {
      "description": "Open the deck builder to arrange your cards.",
      "name_localizations": {
        "ko": "덱설정",
        "zh-TW": "牌組設定"
      },
      "description_localizations": {
        "ko": "보유 카드로 덱을 구성합니다.",
        "zh-TW": "使用持有的卡片編組牌組。"
      }
    },
    "match": {
      "description": "Challenge another player to a card battle with points at stake.",
      "name_localizations": {
        "ko": "매치",
        "zh-TW": "對戰"
      },
      "description_localizations": {
        "ko": "다른 유저에게 판돈을 걸고 카드 대결을 신청합니다.",
        "zh-TW": "向其他玩家發起賭上點數的卡片對戰。"
      }
    },
    "friendly": {
      "description": "Challenge another player to a card battle with no points at stake.",
